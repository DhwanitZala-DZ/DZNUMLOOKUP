{
  "version": 2,
  "rewrites": [
    { "source": "/num", "destination": "/api/num" },
    { "source": "/veh", "destination": "/api/veh" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-dz-key" },
        { "key": "X-Powered-By", "value": "DZ HACKER" }
      ]
    }
  ]
}
